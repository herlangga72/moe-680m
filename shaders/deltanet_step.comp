// ── DeltaNet state update: S = gate·S (decay only) ──
// QKV buffer layout (4128 f16): Q[2048] + K[2048] + gate[32]
// V not present in this model variant — state decays without outer product.
// Per head pair (QK head × V head), state S is 128×128 f32
// Dispatch: (16 QK heads, 32 V heads, 1)
// Each TG: 128 threads, handles one QK×V head pair
// Each thread: handles one row of S

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_scalar_block_layout : require

layout(std430, binding = 0) buffer Arena { uint data[]; };
layout(push_constant) uniform PC {
    uint64_t input_offset; uint64_t weights_offset; uint64_t output_offset;
    uint M; uint N; uint K; uint num_experts;
    uint64_t routing_weights_off; uint num_qk_heads; uint num_v_heads;
    uint layer_idx; uint _pad1; uint64_t token_ids_off; float scale_factor;
} pc;

#include "common.glsl"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

// QKV buffer layout (bytes from input_offset):
//   Q[16×128] at 0
//   K[16×128] at 16×128×2
//   gate[32]  at 32×128×2   (= element 4096, the last 32 of 4128)

void main() {
    uint qkh = gl_GlobalInvocationID.x; // 0..15
    uint vh = gl_GlobalInvocationID.y;  // 0..31
    if (qkh >= pc.num_qk_heads || vh >= pc.num_v_heads) return;

    uint row = gl_LocalInvocationIndex; // 0..127 (row of S)

    uint64_t q_base = pc.input_offset;
    uint64_t state_base = pc.weights_offset + uint64_t(pc.layer_idx) * 16 * 32 * 128 * 128 * 4;

    uint64_t q_off = q_base + qkh * 128 * 2 + row * 2;
    uint64_t k_off = q_base + 16*128*2 + qkh * 128 * 2 + row * 2;

    float k_val = f16_to_f32(read_u16(k_off));
    float q_val = f16_to_f32(read_u16(q_off));

    // Read gate: last 32 elements of the 4128-element QKV buffer (element 4096 + vh)
    uint64_t g_off = q_base + 4096 * 2 + vh * 2;
    float gate = f16_to_f32(read_u16(g_off));
    float one_minus_gate = 1.0 - gate;

    // V is not present in this model variant's QKV output. State decays without outer product.
    // S = gate·S  (no outer(k,v) term)

    // State base for this head pair
    uint64_t hp_off = state_base + qkh * 32 * 128 * 128 * 4 + vh * 128 * 128 * 4;

    // Update S row by row: S[row][col] = gate * S[row][col]
    for (uint c = 0; c < 128; c += 32) {
        uint64_t s_off = hp_off + row * 128 * 4 + c * 4;
        for (uint cc = 0; cc < 32; cc++) {
            uint wi = uint((s_off + cc*4)>>2);
            float s_val = uintBitsToFloat(data[wi]);
            float new_s = gate * s_val;
            data[wi] = floatBitsToUint(new_s);
        }
    }

    barrier();

    // Output: o[row] = Σ S[row][j] × q[j] for j in 0..127
    float o_val = 0.0;
    for (uint j = 0; j < 128; j++) {
        uint64_t s_off = hp_off + row * 128 * 4 + j * 4;
        float s_val = uintBitsToFloat(data[uint(s_off>>2)]);
        uint64_t qj_off = q_base + qkh * 128 * 2 + j * 2;
        float qj = f16_to_f32(read_u16(qj_off));
        o_val += s_val * qj;
    }

    // Write output to output_offset + vh*128*4 + row*4
    uint64_t oa = pc.output_offset + vh * 128 * 4 + row * 4;
    data[uint(oa>>2)] = floatBitsToUint(o_val);
}
