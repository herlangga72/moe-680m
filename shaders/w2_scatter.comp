// ── w2_scatter: w2 + scatter-add, RDNA2 optimized ──
// TG 32×4, coverage 64 M × 8 N, TILE_K=32

#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_scalar_block_layout : require

layout(std430, binding = 0) buffer Arena { uint data[]; };
layout(push_constant) uniform PC {
    uint64_t input_offset; uint64_t weights_offset; uint64_t output_offset;
    uint M; uint N; uint K; uint num_experts;
    uint64_t routing_weights_off; uint num_qk_heads; uint num_v_heads;
    uint layer_idx; uint _pad1; uint64_t token_ids_off; float scale_factor;
} pc;

#include "common.glsl"

shared float At[64][32];
shared float Bt[32][8];
layout(local_size_x = 32, local_size_y = 4, local_size_z = 1) in;

void main() {
    uint tx = gl_LocalInvocationID.x, ty = gl_LocalInvocationID.y;
    uint batch = gl_GlobalInvocationID.x, out_c = gl_GlobalInvocationID.y * 8;
    uint m0 = batch * 64 + tx * 2, n0 = out_c + ty * 2;
    float a00=0,a01=0,a10=0,a11=0;

    for (uint k = 0; k < pc.K; k += 32) {
        for (uint r = 0; r < 2; r++) for (uint c = 0; c < 8; c++) {
            uint mr = tx*2+r, mc = ty*8+c;
            if (m0+r < pc.M && k+mc < pc.K) {
                uint64_t a = pc.input_offset + ((m0+r)*pc.K + k + mc) * 2;
                uint w = data[uint(a>>2)];
                At[mr][mc] = f16_to_f32((w>>(uint(a&3)*8))&0xFFFF);
            } else At[mr][mc] = 0;
        }
        barrier();
        for (uint off = 0; off < 8; off += 4) {
            uint nc = ty + off;
            if (k+tx < pc.K && out_c+nc < pc.N) {
                Bt[tx][nc] = dequant_iq4_xs(pc.weights_offset, (k+tx)*pc.N + out_c+nc);
            } else Bt[tx][nc] = 0;
        }
        barrier();
        for (uint kk = 0; kk < 32; kk++) {
            float a0=At[tx*2+0][kk], a1=At[tx*2+1][kk];
            float b0=Bt[kk][ty*2+0], b1=Bt[kk][ty*2+1];
            a00+=a0*b0; a01+=a0*b1; a10+=a1*b0; a11+=a1*b1;
        }
        barrier();
    }

    // Scatter-add with token_id mapping and routing weight
    for (uint r = 0; r < 2; r++) for (uint c = 0; c < 2; c++) {
        uint mi = m0+r, ni = n0+c;
        if (mi >= pc.M || ni >= pc.N) continue;
        float acc = r==0?(c==0?a00:a01):(c==0?a10:a11);

        uint tid;
        float weight;
        if (pc.token_ids_off == 0uL) { tid = mi; weight = 1.0; }
        else {
            uint64_t ta = pc.token_ids_off + mi*2;
            uint tw = data[uint(ta>>2)];
            tid = (tw>>(uint(ta&3)*8))&0xFFFF;
            uint64_t wa = pc.routing_weights_off + mi*4;
            uint ww = data[uint(wa>>2)];
            weight = uintBitsToFloat(ww);
        }

        float add = acc * weight * pc.scale_factor;

        uint64_t oa = pc.output_offset + (uint64_t(tid)*pc.N + ni)*2;
        uint ow = data[uint(oa>>2)], os = uint(oa&3)*8;
        float exist = f16_to_f32((ow>>os)&0xFFFF);
        float result = exist + add;

        uint f16 = f32_to_f16(result);
        uint wi = uint(oa>>2), sh = uint(oa&3)*8;
        data[wi] = (data[wi]&~(0xFFFFu<<sh)) | (f16<<sh);
    }
}
