#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_memory_scope_semantics : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf0 { float data[]; };
layout(set = 0, binding = 1) buffer Buf1 { uint8_t  data8[]; };
layout(set = 0, binding = 2) buffer Buf2 { uint16_t data16[]; };
layout(set = 0, binding = 3) buffer Buf3 { float data_out[]; };

#include "common.glsl"

// Shared memory for per-thread top-1 candidates (final merge)
shared float s_cand_vals[256];
shared uint  s_cand_idxs[256];
shared float s_global_top_vals[64];  // up to 64 top candidates
shared uint  s_global_top_idxs[64];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint vocab_size = pc.rows;
    float temperature = pc.param0;
    float top_p = pc.param1;
    uint top_k = pc.opt0;
    uint seed = pc.opt1;

    if (vocab_size == 0u) {
        if (tid == 0u) data_out[0] = 0.0;
        return;
    }

    // ── Phase 1: Top-K candidates per thread ──
    // Each thread scans its strided portion of the vocabulary
    // and maintains a sorted list of top-K logits/tokens.
    // Use local array (max K = 48 for safety, limited by register pressure).

#define MAX_K 48u
    float t_vals[MAX_K];
    uint  t_idxs[MAX_K];
    uint  k_actual = min(top_k, MAX_K);
    if (k_actual == 0u) k_actual = 1u;

    for (uint i = 0u; i < k_actual; i++) {
        t_vals[i] = -3.4e38;
        t_idxs[i] = 0xFFFFFFFFu;
    }

    for (uint j = tid; j < vocab_size; j += 256u) {
        float logit = data[j];
        if (temperature > 0.0 && temperature != 1.0) {
            logit = logit / temperature;
        }

        // Insert into sorted top-K list (descending)
        for (uint i = 0u; i < k_actual; i++) {
            if (logit > t_vals[i]) {
                // Shift down
                for (uint s = k_actual - 1u; s > i; s--) {
                    t_vals[s] = t_vals[s - 1u];
                    t_idxs[s] = t_idxs[s - 1u];
                }
                t_vals[i] = logit;
                t_idxs[i] = j;
                break;
            }
        }
    }

    // ── Phase 2: Merge per-thread top-K into global top-K ──
    // Each thread writes its best candidate to shared memory
    s_cand_vals[tid] = t_vals[0];
    s_cand_idxs[tid] = t_idxs[0];
    barrier();
    memoryBarrierShared();

    // Thread 0 merges all candidates into global top-K
    if (tid == 0u) {
        for (uint i = 0u; i < k_actual; i++) {
            s_global_top_vals[i] = -3.4e38;
            s_global_top_idxs[i] = 0u;
        }

        for (uint th = 0u; th < 256u; th++) {
            float v = s_cand_vals[th];
            uint idx = s_cand_idxs[th];
            if (idx == 0xFFFFFFFFu) continue;

            // Also scan this thread's remaining candidates from its local array
            // We stored t_vals[0] in shared, need the rest too.
            // For simplicity, only use first candidate per thread if K is large enough.
            // For higher quality, we'd need to store all candidates per thread.
        }
    }

    // Actually, let me use a different approach: store ALL per-thread candidates in shared.
    // But we can only store 256 values in shared (one per thread).
    // So each thread only contributes its top-1 candidate.
    // This is fine for small K (top-40 out of 256 candidates).

    // Thread 0 does global merge
    if (tid == 0u) {
        // Merge all 256 per-thread top-1 candidates into global top-K
        for (uint i = 0u; i < k_actual; i++) {
            s_global_top_vals[i] = -3.4e38;
            s_global_top_idxs[i] = 0u;
        }

        for (uint th = 0u; th < 256u; th++) {
            float v = s_cand_vals[th];
            uint idx = s_cand_idxs[th];
            if (idx == 0xFFFFFFFFu) continue;

            for (uint i = 0u; i < k_actual; i++) {
                if (v > s_global_top_vals[i]) {
                    for (uint s = k_actual - 1u; s > i; s--) {
                        s_global_top_vals[s] = s_global_top_vals[s - 1u];
                        s_global_top_idxs[s] = s_global_top_idxs[s - 1u];
                    }
                    s_global_top_vals[i] = v;
                    s_global_top_idxs[i] = idx;
                    break;
                }
            }
        }
    }
    barrier();
    memoryBarrierShared();

    // ── Phase 3: Softmax over global top-K ──
    if (tid == 0u) {
        // Find max for numerical stability
        float mx = s_global_top_vals[0];
        for (uint i = 1u; i < k_actual; i++) {
            mx = max(mx, s_global_top_vals[i]);
        }

        // Compute exp and sum
        float sum_exp = 0.0;
        for (uint i = 0u; i < k_actual; i++) {
            float e = exp(s_global_top_vals[i] - mx);
            s_global_top_vals[i] = e;
            sum_exp += e;
        }

        // Normalize to probabilities
        float inv_sum = 1.0 / sum_exp;
        for (uint i = 0u; i < k_actual; i++) {
            s_global_top_vals[i] = s_global_top_vals[i] * inv_sum;
        }

        // ── Phase 4: Top-P (nucleus) filtering ──
        // Cumulative sum, zero out tokens past threshold
        if (top_p < 1.0 && top_p > 0.0) {
            float cum = 0.0;
            for (uint i = 0u; i < k_actual; i++) {
                cum += s_global_top_vals[i];
                if (cum > top_p && i > 0u) {
                    // Zero out the rest
                    for (uint j = i + 1u; j < k_actual; j++) {
                        s_global_top_vals[j] = 0.0;
                    }
                    break;
                }
            }

            // Re-normalize
            float sum2 = 0.0;
            for (uint i = 0u; i < k_actual; i++) {
                sum2 += s_global_top_vals[i];
            }
            if (sum2 > 0.0) {
                float inv_sum2 = 1.0 / sum2;
                for (uint i = 0u; i < k_actual; i++) {
                    s_global_top_vals[i] = s_global_top_vals[i] * inv_sum2;
                }
            }
        }

        // ── Phase 5: Sample from distribution ──
        // Simple LCG random number
        uint rng = seed;
        rng = rng * 1103515245u + 12345u;
        float r = float(rng & 0x7FFFFFFFu) / float(0x7FFFFFFFu);

        // Inversion sampling: walk CDF until we cross r
        float cdf = 0.0;
        uint token = 0u;
        for (uint i = 0u; i < k_actual; i++) {
            cdf += s_global_top_vals[i];
            if (r <= cdf || i == k_actual - 1u) {
                token = s_global_top_idxs[i];
                break;
            }
        }

        // Write selected token as float to data_out[0]
        data_out[0] = float(token);
    }
}
