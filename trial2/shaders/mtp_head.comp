#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_memory_scope_semantics : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf0 { float data[]; };
layout(set = 0, binding = 1) buffer Buf1 { uint8_t  data8[]; };
layout(set = 0, binding = 2) buffer Buf2 { uint16_t data16[]; };
layout(set = 0, binding = 3) buffer Buf3 { float weight[]; };
layout(set = 0, binding = 4) buffer Buf4 { float data_out[]; };

#include "common.glsl"

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint dim = pc.cols;            // hidden dimension
    uint vocab_size = pc.stride;

    // Linear projection: dim → vocab_size with iQ4_XS weight
    // Input: data (hidden state, same as lm_head)
    // Output: logits (FP32, to data_out)

    for (uint j = tid; j < vocab_size; j += 256u) {
        float sum = 0.0;
        for (uint k = 0u; k < dim; k++) {
            sum += data[k] * dequant_iq4_xs(0u, j * dim + k);
        }
        data_out[j] = sum;
    }
}
