#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_memory_scope_semantics : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf0 { float data[]; };
layout(set = 0, binding = 1) buffer Buf1 { uint8_t  data8[]; };
layout(set = 0, binding = 2) buffer Buf2 { uint16_t data16[]; };
layout(set = 0, binding = 3) buffer Buf3 { float q_out[]; };
layout(set = 0, binding = 4) buffer Buf4 { float k_out[]; };
layout(set = 0, binding = 5) buffer Buf5 { float v_out[]; };

#include "common.glsl"

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint dim = pc.cols;                      // hidden dimension
    uint n_q_heads = pc.opt0;
    uint n_kv_heads = pc.opt1;
    uint head_dim = pc.opt2;
    uint row_offset = pc.rows;               // batch/token offset in output

    uint q_len = n_q_heads * head_dim;
    uint kv_len = n_kv_heads * head_dim;
    uint total = q_len + 2u * kv_len;

    for (uint j = tid; j < total; j += 256u) {
        float sum = 0.0;
        // Dot product: output[j] = sum_k input[k] * weight[j][k]
        for (uint k = 0u; k < dim; k++) {
            sum += data[k] * dequant_iq4_xs(0u, j * dim + k);
        }

        if (j < q_len) {
            q_out[row_offset + j] = sum;
        } else if (j < q_len + kv_len) {
            k_out[row_offset + j - q_len] = sum;
        } else {
            v_out[row_offset + j - q_len - kv_len] = sum;
        }
    }
}
