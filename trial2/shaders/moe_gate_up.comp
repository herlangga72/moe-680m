#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_memory_scope_semantics : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf0 { float data[]; };
layout(set = 0, binding = 1) buffer Buf1 { uint8_t  data8[]; };
layout(set = 0, binding = 2) buffer Buf2 { uint16_t data16[]; };
layout(set = 0, binding = 3) buffer Buf3 { float gate_w[]; };
layout(set = 0, binding = 4) buffer Buf4 { float up_w[]; };
layout(set = 0, binding = 5) buffer Buf5 { float data_out[]; };

#include "common.glsl"

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint dim = pc.cols;                    // hidden dimension
    uint ffn_intermediate = pc.opt0;
    uint expert_idx = pc.opt1;             // which expert to use
    uint is_shared = pc.opt2;              // 1 if this is a shared expert

    uint row_offset = pc.rows;             // output row offset

    // We have two weight matrices positioned sequentially in data16:
    //   gate_weight: [expert][ffn_intermediate * dim]
    //   up_weight:   [expert][ffn_intermediate * dim]
    // The expert_idx selects which expert's weights to use.
    // Weight matrices are stored in data16, indexed through dequant_iq4_xs().
    //
    // Each weight matrix for one expert has ffn_intermediate rows × dim columns.
    // The dequant function indexes elements linearly: element_idx = row * dim + col
    // For expert e, the gate weight starts at e * ffn_intermediate * dim, etc.
    // But since dequant_iq4_xs ignores blk_start, the offset must be zero-based.
    // The caller ensures the data16 buffer binding points to the correct expert's
    // weight data. So we index from 0 for each call.

    uint gate_offset = 0u;  // gate weight starts at data16 offset 0
    uint up_offset = ffn_intermediate * dim;  // up weight after gate weight

    uint total_out = 2u * ffn_intermediate;

    for (uint j = tid; j < total_out; j += 256u) {
        float sum = 0.0;
        if (j < ffn_intermediate) {
            // Gate projection
            for (uint k = 0u; k < dim; k++) {
                sum += data[k] * dequant_iq4_xs(0u, j * dim + k);
            }
        } else {
            // Up projection
            uint up_j = j - ffn_intermediate;
            for (uint k = 0u; k < dim; k++) {
                sum += data[k] * dequant_iq4_xs(0u, up_offset + up_j * dim + k);
            }
        }
        data_out[row_offset + j] = sum;
    }
}
