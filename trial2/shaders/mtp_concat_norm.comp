#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_memory_scope_semantics : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf0 { float data[]; };
layout(set = 0, binding = 1) buffer Buf1 { uint8_t  data8[]; };
layout(set = 0, binding = 2) buffer Buf2 { uint16_t data16[]; };
layout(set = 0, binding = 3) buffer Buf3 { float token_emb[]; };
layout(set = 0, binding = 4) buffer Buf4 { float data_out[]; };

#include "common.glsl"

shared float s_sg_sums[4];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint dim = pc.cols;            // hidden dimension
    float eps = pc.param0;

    // Concat hidden_state (data[0..dim)) + token_emb (token_emb[0..dim))
    // → data_out[0..2*dim) as concatenated vector
    // Then RMSNorm on the concatenated vector

    // ── Concat ──
    // First half: copy hidden state
    for (uint j = tid; j < dim; j += 256u) {
        data_out[j] = data[j];
    }
    // Second half: copy token embedding
    for (uint j = tid; j < dim; j += 256u) {
        data_out[dim + j] = token_emb[j];
    }
    barrier();

    uint concat_dim = 2u * dim;

    // ── RMSNorm on concatenated vector ──
    float sum_sq = 0.0;
    for (uint j = tid; j < concat_dim; j += 256u) {
        float v = data_out[j];
        sum_sq += v * v;
    }

    float sg_sum = subgroup_sum(sum_sq);

    if (gl_SubgroupInvocationID == 0u) {
        s_sg_sums[gl_SubgroupID] = sg_sum;
    }
    barrier();
    memoryBarrierShared();

    if (tid == 0u) {
        float total = 0.0;
        for (uint i = 0u; i < 4u; i++) {
            total += s_sg_sums[i];
        }
        s_sg_sums[0] = rsqrt_fast(total / float(concat_dim) + eps);
    }
    barrier();
    memoryBarrierShared();

    float rms = s_sg_sums[0];

    // Apply RMSNorm in-place on data_out (weight = 1.0 for MTP)
    for (uint j = tid; j < concat_dim; j += 256u) {
        data_out[j] = data_out[j] * rms;
    }
}
