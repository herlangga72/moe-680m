#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_memory_scope_semantics : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf0 { float data[]; };
layout(set = 0, binding = 1) buffer Buf1 { uint8_t  data8[]; };
layout(set = 0, binding = 2) buffer Buf2 { uint16_t data16[]; };
layout(set = 0, binding = 3) buffer Buf3 { float norm_w[]; };
layout(set = 0, binding = 4) buffer Buf4 { float output_w[]; };
layout(set = 0, binding = 5) buffer Buf5 { float data_out[]; };

#include "common.glsl"

shared float s_sg_sums[4]; // cross-subgroup reduction for RMS sum-of-squares
shared float s_rms_val;    // broadcast RMS value

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint dim = pc.cols;                    // hidden dimension
    uint vocab_size = pc.stride;
    float eps = pc.param0;
    uint row_offset = pc.rows;             // row offset in input

    // ── RMSNorm on hidden state ──
    // data[row_offset..row_offset+dim) is the input hidden state
    // norm_w[i] are the RMSNorm weight parameters

    float sum_sq = 0.0;
    for (uint j = tid; j < dim; j += 256u) {
        float v = data[row_offset + j];
        sum_sq += v * v;
    }

    // Subgroup reduction
    float sg_sum = subgroup_sum(sum_sq);

    // Cross-subgroup via shared memory
    if (gl_SubgroupInvocationID == 0u) {
        s_sg_sums[gl_SubgroupID] = sg_sum;
    }
    barrier();
    memoryBarrierShared();

    if (tid == 0u) {
        float total = 0.0;
        for (uint i = 0u; i < 4u; i++) {
            total += s_sg_sums[i];
        }
        s_rms_val = rsqrt_fast(total / float(dim) + eps);
    }
    barrier();
    memoryBarrierShared();

    float rms = s_rms_val;

    // ── Linear projection: vocab × dim (iQ4_XS) ──
    // output[0..vocab_size) = RMSNorm(hidden) × output_weight^T
    // output_weight is vocab_size × dim

    for (uint j = tid; j < vocab_size; j += 256u) {
        float sum = 0.0;
        for (uint k = 0u; k < dim; k++) {
            float h = data[row_offset + k] * norm_w[k] * rms;
            sum += h * dequant_iq4_xs(0u, j * dim + k);
        }
        data_out[j] = sum;
    }
}
