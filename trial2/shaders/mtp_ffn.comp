#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_shader_8bit_storage : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_memory_scope_semantics : enable

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Buf0 { float data[]; };
layout(set = 0, binding = 1) buffer Buf1 { uint8_t  data8[]; };
layout(set = 0, binding = 2) buffer Buf2 { uint16_t data16[]; };
layout(set = 0, binding = 3) buffer Buf3 { float gate_w[]; };
layout(set = 0, binding = 4) buffer Buf4 { float up_w[]; };
layout(set = 0, binding = 5) buffer Buf5 { float down_w[]; };
layout(set = 0, binding = 6) buffer Buf6 { float data_out[]; };

#include "common.glsl"

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint dim = pc.cols;                    // hidden dimension
    uint ffn_intermediate = pc.opt0;
    uint row_offset = pc.rows;             // output row offset

    // Temporary buffer for intermediate (first half of data_out or a global temp)
    // We'll write gate and up to a temp area, then apply SiLU and multiply,
    // then down-project, and finally residual-add.
    //
    // Since this is an MTP FFN (not MoE), it's a simple dense SwiGLU:
    //   out = down(SiLU(gate(x)) * up(x)) + x
    //
    // We have three iQ4_XS weight matrices:
    //   gate_w: ffn_intermediate × dim
    //   up_w:   ffn_intermediate × dim
    //   down_w: dim × ffn_intermediate
    //
    // The caller binds data16 to the appropriate position.

    // ── Phase 1: Gate + Up projection ──
    // Write both results to a contiguous temp area in data_out
    // First ffn_intermediate elements = gate, next = up
    uint ffn2 = ffn_intermediate * 2u;
    for (uint j = tid; j < ffn2; j += 256u) {
        float sum = 0.0;
        if (j < ffn_intermediate) {
            for (uint k = 0u; k < dim; k++) {
                sum += data[k] * dequant_iq4_xs(0u, j * dim + k);
            }
        } else {
            uint up_j = j - ffn_intermediate;
            for (uint k = 0u; k < dim; k++) {
                sum += data[k] * dequant_iq4_xs(0u, ffn_intermediate * dim + up_j * dim + k);
            }
        }
        data_out[row_offset + j] = sum;
    }
    barrier();

    // ── Phase 2: SiLU(gate) * up, in-place on first half ──
    for (uint j = tid; j < ffn_intermediate; j += 256u) {
        float gate = data_out[row_offset + j];
        float up = data_out[row_offset + ffn_intermediate + j];
        float sig = 1.0 / (1.0 + exp(-gate));
        data_out[row_offset + j] = (gate * sig) * up; // activated intermediate
    }
    barrier();

    // ── Phase 3: Down projection ──
    // Read activated intermediate from data_out[row_offset..row_offset+ffn_intermediate)
    // Write to temp (data, which still has the residual)
    for (uint j = tid; j < dim; j += 256u) {
        float sum = 0.0;
        for (uint k = 0u; k < ffn_intermediate; k++) {
            float act = data_out[row_offset + k];
            sum += act * dequant_iq4_xs(0u, j * ffn_intermediate + k); // down weight
        }

        // ── Phase 4: Residual add ──
        data_out[row_offset + ffn2 + j] = data[j] + sum; // data[j] is the saved residual
    }
}
